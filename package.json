{
  "name": "sauce-demo-playwright",
  "version": "1.0.0",
  "description": "Production-quality Playwright + TypeScript E2E suite for Sauce Demo",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:auth": "playwright test tests/auth.spec.ts",
    "test:inventory": "playwright test tests/inventory.spec.ts",
    "test:checkout": "playwright test tests/checkout.spec.ts",
    "test:problem-user": "playwright test tests/problem-user.spec.ts",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "typescript",
    "e2e",
    "page-object-model",
    "saucedemo"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3"
  }
}
